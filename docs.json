{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    },
    "links": [
      {
        "href": "mailto:support@mintlify.com",
        "label": "Support"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Blog1",
        "icon": "book-open-cover",
        "pages": [
          "development",
          "navigation"
        ]
      },
      {
        "group": "Blog",
        "icon": "newspaper",
        "root": "test",
        "pages": [
          "development-2",
          "api-reference/introduction",
          {
            "group": "xxxx",
            "pages": [
              "editor",
              "untitled-page-2"
            ]
          }
        ]
      }
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "strict": false
  },
  "banner": {
    "content": "🎉 Join us at our annual conference!",
    "dismissible": true,
    "color": {
      "light": "#2128e4"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "toc"
  }
}
